<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Sample data: 10,000 employees across 10 countries, with their salary history.

        The rows live in two plain CSV files you can open and read:
            db/seed/employees.csv
            db/seed/salary_history.csv
        They are produced by the deterministic generator in src/test (SeedFileWriter) and a test fails if they ever drift
        from it. To change the sample data, change the generator and re-run it.

        - context "seed": only applied when the "seed" context is active (spring.liquibase.contexts). Tests leave it off.
        - precondition: if the employees table already has rows the changeset is skipped (marked as ran) instead of failing
          or mixing sample rows into real data.
        - one changeset = one transaction: all of the data loads, or none of it.
        - EVERY column is given an explicit type below. Left to guess, Liquibase maps SQLite TEXT columns to CLOB and then
          treats each cell as the name of a file to read, searching the classpath once per cell (very slow from a packaged
          jar, and it would silently replace a cell that happened to match a resource name with that file's contents).
    -->
    <changeSet id="003-seed-sample-data" author="salary-management" context="seed">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM employees</sqlCheck>
        </preConditions>

        <loadData file="db/seed/employees.csv" tableName="employees" separator="," quotchar="&quot;" encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="employee_code" type="STRING"/>
            <column name="first_name" type="STRING"/>
            <column name="last_name" type="STRING"/>
            <column name="email" type="STRING"/>
            <column name="country" type="STRING"/>
            <column name="department" type="STRING"/>
            <column name="job_title" type="STRING"/>
            <column name="job_level" type="STRING"/>
            <column name="currency" type="STRING"/>
            <column name="salary_minor" type="NUMERIC"/>
            <column name="hire_date" type="STRING"/>
            <column name="status" type="STRING"/>
            <column name="created_at" type="STRING"/>
            <column name="updated_at" type="STRING"/>
        </loadData>

        <loadData file="db/seed/salary_history.csv" tableName="salary_history" separator="," quotchar="&quot;" encoding="UTF-8">
            <column name="employee_id" type="NUMERIC"/>
            <column name="old_salary_minor" type="NUMERIC"/>
            <column name="new_salary_minor" type="NUMERIC"/>
            <column name="currency" type="STRING"/>
            <column name="effective_date" type="STRING"/>
            <column name="reason" type="STRING"/>
            <column name="changed_at" type="STRING"/>
        </loadData>

        <!--
            SQLite has no date type. The application stores dates as epoch milliseconds at midnight UTC (see D32 in the
            design notes), so the readable ISO dates in the CSV files are converted once here, after loading.
            strftime('%s', ...) reads the text as UTC, which is exactly the stored convention.
        -->
        <sql>
            UPDATE employees
               SET hire_date  = CAST(strftime('%s', hire_date)  AS INTEGER) * 1000,
                   created_at = CAST(strftime('%s', created_at) AS INTEGER) * 1000,
                   updated_at = CAST(strftime('%s', updated_at) AS INTEGER) * 1000
             WHERE typeof(hire_date) = 'text'
        </sql>
        <sql>
            UPDATE salary_history
               SET effective_date = CAST(strftime('%s', effective_date) AS INTEGER) * 1000,
                   changed_at     = CAST(strftime('%s', changed_at)     AS INTEGER) * 1000
             WHERE typeof(effective_date) = 'text'
        </sql>

        <rollback>
            <sql>DELETE FROM salary_history</sql>
            <sql>DELETE FROM employees</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
